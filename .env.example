# DesignConia — configuración del asistente
#
# Copia este archivo a .env.local y rellena la clave. .env.local está en
# .gitignore, así que no se sube al repositorio.

# Obligatoria. Sin ella la app funciona, pero el asistente no puede generar:
# avisa y te dice qué falta.
DEEPSEEK_API_KEY=

# Opcionales.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
