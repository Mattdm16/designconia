# DesignConia — configuración del asistente
#
# Copia este archivo a .env.local y rellena la clave. .env.local está en
# .gitignore, así que no se sube al repositorio.

# Obligatoria. Sin ella la app funciona, pero el asistente no puede generar:
# avisa y te dice qué falta.
DEEPSEEK_API_KEY=

# Opcionales.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Nube opcional (Supabase, plan gratuito). Sin estas dos variables la app
# funciona 100% en local y el botón «Nube» explica cómo activarla. Ver
# docs/NUBE.md para crear el proyecto y la tabla `proyectos`.
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon
